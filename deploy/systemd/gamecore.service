[Unit]
Description=GameCore authoritative game node (Java 21 TLS)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=exec
User=gamecore
Group=gamecore
WorkingDirectory=/var/lib/gamecore
EnvironmentFile=/etc/gamecore/gamecore.env
Environment=GAMECORE_CONFIG=/etc/gamecore/server.properties
Environment=GAMECORE_LOG_DIR=/var/log/gamecore
ExecStartPre=/opt/gamecore/current/deploy/scripts/start.sh --check
ExecStart=/opt/gamecore/current/deploy/scripts/start.sh
ExecStartPost=/opt/gamecore/current/deploy/scripts/wait-ready.sh
KillSignal=SIGTERM
KillMode=mixed
TimeoutStartSec=40
TimeoutStopSec=60
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
UMask=0027
StateDirectory=gamecore
LogsDirectory=gamecore
RuntimeDirectory=gamecore
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryHigh=800M
MemoryMax=896M
MemorySwapMax=128M
TasksMax=96
LimitNOFILE=2048
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gamecore
LogRateLimitIntervalSec=30s
LogRateLimitBurst=300

[Install]
WantedBy=multi-user.target
