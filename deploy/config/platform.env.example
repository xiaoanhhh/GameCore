# 可选平台进程，不能与gamecore.env的服务器密钥不同。
GAME_SERVER_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
GAME_SERVER_ID=local-1
GAME_PUBLIC_HOST=game.example.com
GAME_PUBLIC_PORT=7201
GAME_PUBLIC_TLS=true
PLATFORM_BIND=127.0.0.1
PLATFORM_PORT=8080
PLATFORM_DB_URL=jdbc:postgresql://127.0.0.1:5432/gamecore
PLATFORM_DB_USER=gamecore
PLATFORM_DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=4
SERVER_TOMCAT_THREADS_MAX=16
